# HH Goa 2026 — Voice RAG
# Environment Variables Example
#
# Copy this file to .env and fill in your actual credentials.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   # Then start the server:
#   uvicorn api:app --host 0.0.0.0 --port 8000

# ============================================================
# SARVAM STT API
# ============================================================

# Get your API key from: https://dashboard.sarvam.ai/
# Required for real Speech-to-Text.
# If not set, the system uses mock STT (development mode only).
SARVAM_API_KEY=sk_bwiqua7d_1DI5BlxZCopztzSOEYoJpZ3O

# ============================================================
# QDRANT (Optional — for remote Qdrant Cloud)
# ============================================================

# If using Qdrant Cloud instead of local SQLite:
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION=hh_goa_rag_hindi

# For local development (default — no config needed):
# The system uses data/qdrant/ as local SQLite storage.

# ============================================================
# LLM API KEY (Future — for generative answer generation)
# ============================================================

# If using a generative LLM instead of extractive answers:
# IBM_API_KEY=your_ibm_watsonx_api_key_here
# IBM_PROJECT_ID=your_watsonx_project_id_here
# OPENAI_API_KEY=your_openai_key_here
# GROQ_API_KEY=your_groq_key_here

# ============================================================
# SERVER CONFIG
# ============================================================

# API server host and port
# HOST=0.0.0.0
# PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
