# HH Goa 2026 — Voice RAG
# Environment Variables Reference
#
# Copy this file to .env and fill in your actual credentials.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values, then start the server:
#   uvicorn app.api:app --host 0.0.0.0 --port 8000

# ============================================================
# SARVAM STT API
# ============================================================

# Get your key from: https://dashboard.sarvam.ai/
# Required for real Speech-to-Text (voice endpoint).
# For offline/dev tests only, set SARVAM_STT_MOCK=1 to use mock STT.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MOCK=0

# ============================================================
# QDRANT VECTOR DATABASE
# ============================================================

# Local SQLite storage (default — no extra config needed).
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=hh_goa_rag_multilingual

# Remote Qdrant Cloud (optional — uncomment to use instead of local).
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here

# Retrieval settings.
QDRANT_TOP_K=10        # Candidates fetched from Qdrant before reranking.
TOP_K_FINAL=3          # Top chunks kept after reranking for answer generation.

# ============================================================
# EMBEDDING MODEL
# ============================================================

# Multilingual MiniLM — 384-dim, covers 13 Indic languages.
# Do NOT change unless you re-ingest the corpus with the new model.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_THREADS=4    # CPU threads for the embedding model.

# ============================================================
# CONTEXT COMPRESSION
# ============================================================

TOP_CONTEXT_CHUNKS=2   # Chunks passed into the context window.
MAX_CONTEXT_CHARS=1200 # Hard character limit on compressed context.

# ============================================================
# LLM — ACTIVE BACKEND: GEMINI
# ============================================================

# Backend selection:
#   gemini     — Google Gemini API (active, production).
#   qwen_api   — Hugging Face OpenAI-compatible API (legacy / fallback).
#   extractive — Local extractive fallback, no API key needed (dev/offline).
ANSWER_BACKEND=gemini

# ── Gemini ─────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Install SDK   : pip install google-genai
#
# Free-tier quotas (as of 2025):
#   gemini-2.5-flash-lite        — 20 req/min  (default, lowest latency)
#   gemini-2.0-flash-lite        — 30 req/min  (recommended for demos)
#   gemini-2.0-flash             — 15 req/min  (higher quality)
#
# If you hit "429 RESOURCE_EXHAUSTED" switch to gemini-2.0-flash-lite.
# Non-thinking mode is enabled via thinking_budget=0 (official API parameter).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=30   # Keep small for low latency (benchmark: 30).
GEMINI_THINKING_BUDGET=0      # 0 = non-thinking mode (official parameter).
GEMINI_TIMEOUT_SECONDS=10     # Per-request wall-clock timeout.

# ── Qwen / Hugging Face (legacy fallback) ─────────────────────────────────
LLM_PROVIDER=huggingface
LLM_API_KEY=your_huggingface_api_key_here
# HF_API_KEY=your_huggingface_api_key_here   # legacy alias for LLM_API_KEY
# HF_TOKEN=your_huggingface_api_key_here     # legacy alias for LLM_API_KEY
LLM_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions
# HF_CHAT_COMPLETIONS_URL=...                # legacy alias for LLM_CHAT_COMPLETIONS_URL
QWEN_MODEL=Qwen/Qwen3-0.6B
MAX_NEW_TOKENS=64
LLM_TIMEOUT_SECONDS=10
LLM_TEMPERATURE=0

# ============================================================
# OFFLINE MODE
# ============================================================

# Prevents the sentence-transformers / HF hub from attempting
# downloads at startup. Keep true in production — the embedding
# model is already cached locally.
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=1

# ============================================================
# SERVER CONFIG
# ============================================================

# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
