# HH Goa 2026 — Voice RAG
# Environment Variables Example
#
# Copy this file to .env and fill in your actual credentials.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   # Then start the server:
#   uvicorn api:app --host 0.0.0.0 --port 8000

# ============================================================
# SARVAM STT API
# ============================================================

# Get your API key from: https://dashboard.sarvam.ai/
# Required for real Speech-to-Text.
# If not set, the system uses mock STT (development mode only).
SARVAM_API_KEY=your_sarvam_api_key_here

# ============================================================
# QDRANT (Optional — for remote Qdrant Cloud)
# ============================================================

# If using Qdrant Cloud instead of local SQLite:
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION=hh_goa_rag_multilingual

# For local development (default — no config needed):
# The system uses data/qdrant/ as local SQLite storage.

# ============================================================
# LLM API KEY (Future — for generative answer generation)
# ============================================================

# The default endpoint is Hugging Face's OpenAI-compatible router.
# LLM_API_KEY / LLM_CHAT_COMPLETIONS_URL can target another compatible provider.

# ============================================================
# SERVER CONFIG
# ============================================================

# API server host and port
# HOST=0.0.0.0
# PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ============================================================
# MULTILINGUAL RAG
# ============================================================

QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=hh_goa_rag_multilingual
QDRANT_TOP_K=10

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_THREADS=4

TOP_CONTEXT_CHUNKS=2
MAX_CONTEXT_CHARS=1200

# Use "qwen_api" for remote Qwen generation. No Qwen model is loaded locally.
# Use "extractive" only for offline retrieval development.
ANSWER_BACKEND=qwen_api
LLM_PROVIDER=huggingface
LLM_API_KEY=your_huggingface_api_key_here
LLM_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions
# Legacy aliases also work: HF_API_KEY and HF_CHAT_COMPLETIONS_URL.
#
# Phase 2 active model: Qwen2.5-0.5B-Instruct
# Concise instruction-following generation — no chain-of-thought / thinking.
# Non-thinking behaviour is enforced via model selection + answer-only prompt
# + short token budget. No provider-specific reasoning flag is used.
QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MAX_NEW_TOKENS=64
LLM_TIMEOUT_SECONDS=5
LLM_TEMPERATURE=0
HF_HUB_OFFLINE=true
